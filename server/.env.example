# Copy to server/.env and fill in. .env is gitignored; never commit it.

# PayPal REST app (developer.paypal.com > Apps & Credentials > Sandbox)
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Webhook ID from the same app's Webhooks section. Subscribe it to
# PAYMENT.PAYOUTSBATCH.*, PAYMENT.PAYOUTS-ITEM.* and PAYMENT.CAPTURE.*
# pointing at https://<your-host>/api/webhooks/paypal
PAYPAL_WEBHOOK_ID=

# AI agent. Set ONE provider's key; AI_PROVIDER picks which to use
# (unset: Anthropic if its key is present, otherwise OpenAI).
AI_PROVIDER=
# OpenAI (platform.openai.com > API keys)
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.5
# Anthropic (console.anthropic.com)
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5
# AI_EFFORT=medium

# Passcode the coordinator console asks for before running the agent or
# approving payouts. Leave empty only for local development.
COORDINATOR_KEY=

# Sandbox personal-account emails, comma-separated. Seeded families get
# these round-robin so demo payouts land in real sandbox wallets.
# Only read when the data file is first created (delete server/data/ to reseed).
SEED_RECEIVER_EMAILS=

# Receiver for `npm run smoke`
SMOKE_RECEIVER_EMAIL=

# USD or PHP; must match the sender account's balance currency
PAYOUT_CURRENCY=PHP
# PORT=8787
# DATA_DIR=./data
# AGENT_RUNS_PER_HOUR=20

# Postgres connection string. Vercel + Neon sets it for you; leave unset
# locally to use a JSON file under DATA_DIR.
# DATABASE_URL=

# Where PayPal Checkout sends funders back. Needed anywhere but localhost and Vercel.
# PUBLIC_URL=https://your-host.example

# Jev (TypeSafe AI System One). Unset: Jev is skipped.
# TYPESAFE_API_KEY=
# TYPESAFE_MODEL=jev-latest
# JEV_PLACE_THRESHOLD=0.95

# 1 (default): a bulletin the rules read completely is paid without approval.
# 0: a coordinator approves every run.
# AUTO_RELEASE=1

# The Java core (core/): off (default), shadow (compare), on (the core decides).
# CORE_MODE=off
# CORE_URL=
# CORE_TOKEN=

# Demo switches. 0 hides the demo farmer picker / requires funder access codes.
# DEMO_FARMERS=1
# DEMO_FUNDERS=1
# FUNDER_CODES={"fnd_pcic":"change-me"}
# APP_AI_CALLS_PER_HOUR=200

# Behind a proxy other than Vercel: how many proxies set X-Forwarded-For.
# TRUST_PROXY_HOPS=1
